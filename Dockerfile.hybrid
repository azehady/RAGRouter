FROM python:3.12-slim AS builder

WORKDIR /app
COPY pyproject.toml .
COPY ragrouter/ ragrouter/
RUN pip install --no-cache-dir uv && uv pip install --system ".[hybrid]"

FROM python:3.12-slim

WORKDIR /app
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY ragrouter/ ragrouter/

EXPOSE 8001

CMD ["uvicorn", "ragrouter.adapters.hybrid_adapter.main:app", "--host", "0.0.0.0", "--port", "8001"]
